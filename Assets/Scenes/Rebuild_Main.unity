--- !u!114 &1621168804
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1621168803}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5eb606c2a31cc134e8766448b2d40a96, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Rebuild.UI.TutorialFrameUI
  panelRoot: {fileID: 1626587574}
  titleText: {fileID: 524689060}
  bodyText: {fileID: 2096485574}
  pageIndicator: {fileID: 346484658}
  nextButtonLabel: {fileID: 969166112}
  nextButton: {fileID: 1368945808}
  skipButton: {fileID: 101242874}
  titleImage: {fileID: 1224112035}
  closeButton: {fileID: 0}
  frames:
  - title: "\uBC1C\uAD74 \uBC29\uBC95"
    body: "\uCEE4\uC11C\uB97C <color=#78B99B>\uBC1C\uAD74\uC9C0 \uC704</color>\uC5D0
      \uC62C\uB9AC\uBA74 \uACE1\uAD2D\uC774\uAC00 \uC790\uB3D9\uC73C\uB85C \uBC1C\uAD74\uD569\uB2C8\uB2E4.\n\uBC1C\uAD74
      \uC2DC\uAC04\uC774 \uB05D\uB098\uBA74 \uBAA8\uC740 \uC6D0\uC11D\uC744 \uC815\uC0B0\uD569\uB2C8\uB2E4."
  - title: "\uC6D0\uC11D\uC5D0\uC11C \uC8FC\uAD34\uB85C"
    body: "\uBC1C\uAD74\uD55C \uC6D0\uC11D\uC740 \uC815\uC0B0\uD560 \uB54C <color=#78B99B>\uC8FC\uAD34</color>\uB85C
      \uBC14\uB01D\uB2C8\uB2E4.\n\uC8FC\uAD34\uB85C \uC2A4\uD0AC\uC744 \uAD6C\uB9E4\uD558\uAC70\uB098
      \uACE1\uAD2D\uC774\uB97C \uBCF5\uC6D0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - title: "\uB098\uB9CC\uC758 \uD2B9\uC131"
    body: "\uB808\uBCA8\uC774 \uC624\uB974\uBA74 <color=#78B99B>\uD2B9\uC131 \uCE74\uB4DC</color>\uB97C
      \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC120\uD0DD\uD55C \uD2B9\uC131\uC740
      \uC774\uD6C4 \uBC1C\uAD74\uC5D0\uB3C4 \uC801\uC6A9\uB429\uB2C8\uB2E4."
  - title: "\uBCF5\uC6D0\uACF5\uBC29"
    body: "\uC8FC\uAD34\uB97C \uBAA8\uC544 \uACE1\uAD2D\uC774\uB97C \uBCF5\uC6D0\uD558\uC138\uC694.\n<color=#78B99B>\uBCF5\uC6D0
      \uBC84\uD2BC\uC744 \uAE38\uAC8C \uB204\uB974\uBA74</color> \uB354 \uAC15\uD55C
      \uACE1\uAD2D\uC774\uAC00 \uC644\uC131\uB429\uB2C8\uB2E4."
  - title: "\uC790\uB3D9 \uBC1C\uAD74\uD130"
    body: "\uC790\uB3D9 \uBC1C\uAD74\uD130\uB294 \uC77C\uC815\uD55C \uAC04\uACA9\uC73C\uB85C
      \uC8FC\uAD34\uB97C \uC0DD\uC0B0\uD569\uB2C8\uB2E4.\n\uC8FC\uAD34\uB97C \uC368\uC11C
      <color=#78B99B>\uBC1C\uAD74 \uC8FC\uAE30\uB97C \uC904\uC774\uACE0 \uC0B0\uCD9C\uB7C9\uC744
      \uB298\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</color>"
  - title: "\uC720\uBB3C \uC804\uC2DC"
    body: "\uBC1C\uAD74 \uC911\uC5D0 \uBC1C\uACAC\uD55C <color=#78B99B>\uC720\uBB3C</color>\uC758
      \uD6A8\uACFC\uB294 \uC774\uD6C4\uC5D0\uB3C4 \uACC4\uC18D \uC801\uC6A9\uB429\uB2C8\uB2E4.\n\uBAA8\uC740
      \uC720\uBB3C\uACFC \uADF8 \uD6A8\uACFC\uB294 \uC720\uBB3C \uC804\uC2DC\uC5D0\uC11C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
